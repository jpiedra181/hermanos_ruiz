---
import { Picture } from "astro:assets";
import { useTranslations, rich, yearsSinceFounded, type Lang } from "../i18n/utils";
import garageOld from "../assets/about/garage_old.webp";
import garageNew from "../assets/about/garage_new.webp";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const years = yearsSinceFounded();
const locale = lang === "es" ? "es-ES" : "en-GB";

const title = rich(t("about.title")).replace("{years}", `<span data-years>${years}</span>`);
const stats = [
  { value: years, suffix: "", label: t("about.stat.years"), years: true },
  { value: 15000, suffix: "+", label: t("about.stat.cars") },
  { value: 2, suffix: "", label: t("about.stat.brothers") },
];
const pictureProps = {
  widths: [640, 1024, 1600, 2200],
  sizes: "(min-width: 1440px) 1330px, calc(100vw - 2 * clamp(1rem, 4vw, 3.5rem))",
  formats: ["avif"] as const,
  fallbackFormat: "webp" as const,
  loading: "lazy" as const,
  decoding: "async" as const,
};
---

<section id="about" class="about" aria-labelledby="about-title" data-about>
  <div class="container">
    <div class="about__intro">
      <div>
        <p class="eyebrow" data-reveal="fade">{t("about.eyebrow")}</p>
        <h2 class="section-title about__title" id="about-title" data-reveal="lines" set:html={title} />
      </div>
      <div class="about__text" data-reveal="stagger">
        <p>{t("about.text1")}</p>
        <p>{t("about.text2")}</p>
      </div>
    </div>

    <dl class="stats" data-reveal="stagger">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="stat__label">{s.label}</dt>
            <dd class="stat__value">
              <span class="visually-hidden">
                <span data-years={s.years ? "" : undefined}>{s.value.toLocaleString(locale)}</span>
                {s.suffix}
              </span>
              <span aria-hidden="true">
                <span data-count={s.value} data-years={s.years ? "" : undefined} data-locale={locale}>
                  {s.value.toLocaleString(locale)}
                </span>
                {s.suffix && <span class="stat__suffix">{s.suffix}</span>}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>

    <figure class="compare" data-compare>
      <div class="compare__frame" data-compare-frame data-reveal="clip">
        <Picture src={garageNew} alt={t("about.new.alt")} class="compare__img" {...pictureProps} />
        <div class="compare__old" data-compare-old>
          <Picture src={garageOld} alt={t("about.old.alt")} class="compare__img" {...pictureProps} />
        </div>

        <input
          class="compare__range"
          type="range"
          min="0"
          max="100"
          step="1"
          value="50"
          aria-label={t("about.slider.label")}
          aria-valuetext={t("about.slider.value").replace("{value}", "50")}
          data-value-template={t("about.slider.value")}
          data-compare-range
        />
        <div class="compare__handle" aria-hidden="true">
          <span class="compare__knob">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" /></svg>
          </span>
        </div>

        <span class="compare__tag compare__tag--old" aria-hidden="true">{t("about.old")}</span>
        <span class="compare__tag compare__tag--new" aria-hidden="true">{t("about.new")}</span>
        <span class="compare__cursor" aria-hidden="true" data-compare-cursor><span>{t("about.slider.hint")}</span></span>
      </div>
    </figure>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section);
    background: var(--ink-2);
    border-top: 1px solid var(--line);
  }

  .about__intro {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .about__title {
    margin-top: 1.5rem;
  }

  .about__text {
    display: grid;
    gap: 1.25rem;
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--bone-2);
  }

  @media (min-width: 1024px) {
    .about__intro {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
    }
  }

  /* ── Stats ─────────────────────────────────────────── */
  .stats {
    display: grid;
    margin: 0 0 clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .stat__suffix {
    color: var(--copper);
  }

  .stat__label {
    font-size: var(--fs-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--line);
    }

    .stat {
      padding: 2.5rem 2rem 2.5rem 0;
      border-bottom: 0;
    }

    .stat + .stat {
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
  }

  /* ── Before / after ────────────────────────────────── */
  .compare {
    margin: 0;
  }

  .compare__frame {
    --pos: 50%;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink-3);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  @media (min-width: 768px) {
    .compare__frame {
      aspect-ratio: 16 / 9;
    }
  }

  .compare__frame :global(picture),
  .compare__old {
    position: absolute;
    inset: 0;
  }

  .compare__frame :global(.compare__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .compare__old {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    will-change: clip-path;
  }

  .compare__old :global(img) {
    filter: sepia(0.25) contrast(1.05);
  }

  .compare__range {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 1px;
    background: var(--bone);
    pointer-events: none;
  }

  .compare__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--bone);
    color: var(--ink);
    translate: -50% -50%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition: scale 0.5s var(--ease-out), background-color 0.4s;
  }

  .compare__knob svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .compare__frame:active .compare__knob,
  .compare__frame.is-dragging .compare__knob {
    scale: 0.88;
    background: var(--copper);
  }

  .compare__range:focus-visible ~ .compare__handle .compare__knob {
    outline: 2px solid var(--copper);
    outline-offset: 4px;
  }

  .compare__tag {
    position: absolute;
    bottom: clamp(1rem, 3vw, 2rem);
    padding: 0.5rem 1rem;
    border: 1px solid rgba(237, 232, 223, 0.35);
    border-radius: 999px;
    background: rgba(11, 11, 12, 0.55);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .compare__tag--old {
    left: clamp(1rem, 3vw, 2rem);
  }

  .compare__tag--new {
    right: clamp(1rem, 3vw, 2rem);
  }

  .compare__cursor {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    width: 5.5rem;
    height: 5.5rem;
    margin: -2.75rem 0 0 -2.75rem;
    pointer-events: none;
  }

  .compare__cursor span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--copper);
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 0.3s, transform 0.5s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .compare__cursor {
      display: block;
    }

    .compare__frame:hover .compare__cursor span {
      opacity: 1;
      transform: none;
    }

    .compare__frame.is-dragging .compare__cursor span,
    .compare__frame.near-handle .compare__cursor span {
      opacity: 0;
      transform: scale(0.4);
    }
  }
</style>

<script>
  import { gsap, reducedMotion, finePointer } from "../scripts/motion";

  const root = document.querySelector<HTMLElement>("[data-about]");
  if (root) {
    // Keep "years" honest even if the site is not rebuilt every January.
    const years = String(new Date().getFullYear() - 1996);
    root.querySelectorAll<HTMLElement>("[data-years]").forEach((el) => {
      el.textContent = years;
      if (el.dataset.count) el.dataset.count = years;
    });

    // Count-up stats
    if (!reducedMotion()) {
      root.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
        const end = Number(el.dataset.count);
        const fmt = new Intl.NumberFormat(el.dataset.locale);
        const obj = { v: 0 };
        el.textContent = fmt.format(0);
        gsap.to(obj, {
          v: end,
          duration: end > 100 ? 2.4 : 1.6,
          ease: "power3.out",
          onUpdate: () => (el.textContent = fmt.format(Math.round(obj.v))),
          scrollTrigger: { trigger: el, start: "top 90%", once: true },
        });
      });
    }

    // Before / after
    const frame = root.querySelector<HTMLElement>("[data-compare-frame]")!;
    const range = root.querySelector<HTMLInputElement>("[data-compare-range]")!;
    const cursor = root.querySelector<HTMLElement>("[data-compare-cursor]");
    const template = range.dataset.valueTemplate ?? "{value}";
    const state = { v: 50 };
    let touched = false;

    const set = (v: number) => {
      const value = Math.max(0, Math.min(100, v));
      frame.style.setProperty("--pos", `${value}%`);
      range.value = String(Math.round(value));
      range.setAttribute("aria-valuetext", template.replace("{value}", range.value));
    };

    const fromPointer = (e: PointerEvent) => {
      const r = frame.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    let dragging = false;
    frame.addEventListener("pointerdown", (e) => {
      touched = true;
      gsap.killTweensOf(state);
      dragging = true;
      frame.classList.add("is-dragging");
      frame.setPointerCapture(e.pointerId);
      fromPointer(e);
    });
    frame.addEventListener("pointermove", (e) => {
      if (dragging) fromPointer(e);
    });
    const stop = () => {
      dragging = false;
      frame.classList.remove("is-dragging");
    };
    frame.addEventListener("pointerup", stop);
    frame.addEventListener("pointercancel", stop);

    range.addEventListener("input", () => {
      touched = true;
      gsap.killTweensOf(state);
      set(Number(range.value));
    });

    // A gentle hint that the image can be dragged.
    if (!reducedMotion()) {
      gsap
        .timeline({
          scrollTrigger: { trigger: frame, start: "top 60%", once: true },
          delay: 0.6,
          onUpdate: () => !touched && set(state.v),
        })
        .to(state, { v: 72, duration: 1.1, ease: "power2.inOut" })
        .to(state, { v: 30, duration: 1.4, ease: "power2.inOut" })
        .to(state, { v: 50, duration: 1.1, ease: "power2.inOut" });
    }

    // Cursor label that follows the pointer.
    if (cursor && finePointer()) {
      const xTo = gsap.quickTo(cursor, "x", { duration: 0.5, ease: "power3.out" });
      const yTo = gsap.quickTo(cursor, "y", { duration: 0.5, ease: "power3.out" });
      frame.addEventListener("pointermove", (e) => {
        const r = frame.getBoundingClientRect();
        const x = e.clientX - r.left;
        xTo(x);
        yTo(e.clientY - r.top);
        const handleX = (Number(range.value) / 100) * r.width;
        frame.classList.toggle("near-handle", Math.abs(x - handleX) < 60);
      });
    }
  }
</script>
