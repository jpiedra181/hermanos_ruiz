---
import { useTranslations, type Lang } from "../i18n/utils";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const FRAMES = 40;
const BASE = "/images/hero/seq";
const srcset = [640, 960, 1280].map((w) => `${BASE}/${w}/01.webp ${w}w`).join(", ");

const chapters = [1, 2, 3].map((n) => ({
  num: t(`hero.ch${n}.num` as "hero.ch1.num"),
  text: t(`hero.ch${n}.text` as "hero.ch1.text"),
}));

const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<section
  class="hero"
  id="top"
  aria-labelledby="hero-title"
  data-hero
  data-frames={FRAMES}
  data-base={BASE}
>
  <div class="hero__sticky">
    <div class="hero__media" data-hero-media>
      <div class="hero__zoom">
        <div class="hero__scale" data-hero-scale>
          <img
            class="hero__poster"
            src={`${BASE}/1280/01.webp`}
            srcset={srcset}
            sizes="(orientation: portrait) 120vw, (min-aspect-ratio: 16/9) 100vw, 178vh"
            width="1280"
            height="720"
            alt={t("hero.alt")}
            fetchpriority="high"
            decoding="async"
            data-hero-poster
          />
          <canvas class="hero__canvas" aria-hidden="true" data-hero-canvas></canvas>
        </div>
      </div>
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="hero__curtain" aria-hidden="true"></div>
    </div>

    <div class="hero__inner container">
      <div class="hero__intro" data-hero-intro>
        <p class="hero__eyebrow eyebrow">{t("hero.eyebrow")}</p>
        <h1 class="hero__title" id="hero-title">
          <span class="hl"><span class="hl__in">{t("hero.title.1")}</span></span>
          <span class="hl"><span class="hl__in"><em>{t("hero.title.2")}</em></span></span>
          <span class="hl"><span class="hl__in">{t("hero.title.3")}</span></span>
        </h1>
      </div>

      <div class="hero__foot">
        <div class="hero__cta-group" data-hero-foot>
          <p class="hero__lead">{t("hero.lead")}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#contact" data-magnetic="0.25">
              {t("hero.cta")}
              <span class="btn__icon" aria-hidden="true" set:html={arrow + arrow} />
            </a>
            <a class="btn hero__secondary" href="#process">
              {t("hero.cta2")}
              <span class="btn__icon" aria-hidden="true" set:html={arrow + arrow} />
            </a>
          </div>
        </div>

        <ol class="hero__chapters" aria-hidden="true" data-hero-chapters>
          {
            chapters.map((c) => (
              <li class="chapter">
                <span class="chapter__num">{c.num}</span>
                <span class="chapter__text">{c.text}</span>
              </li>
            ))
          }
        </ol>

        <div class="hud" aria-hidden="true">
          <div class="hud__readout">
            <span class="hud__label">{t("hero.view")}</span>
            <span class="hud__value"><span data-hud-angle>000</span>°</span>
          </div>
          <div class="hud__dial">
            <span class="hud__scale" data-hud-scale></span>
            <span class="hud__needle"></span>
          </div>
          <span class="hud__coords">40.3052° N · 3.7233° W</span>
        </div>
      </div>
    </div>

    <div class="hero__cue" aria-hidden="true" data-hero-cue>
      <span class="hero__cue-line"></span>
      <span>{t("hero.scroll")}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    background: var(--ink);
  }

  :global(html.js) .hero {
    height: 320svh;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero {
      height: 100svh;
    }
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 20rem;
    overflow: hidden;
  }

  /* ── Media ─────────────────────────────────────────── */
  .hero__media {
    position: absolute;
    inset: 7svh 0 0 0;
    overflow: hidden;
  }

  .hero__zoom,
  .hero__scale {
    position: absolute;
    inset: 0;
  }

  .hero__zoom {
    animation: hero-zoom 2.8s var(--ease-out) both;
  }

  .hero__poster,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__canvas {
    opacity: 0;
  }

  .hero__canvas:global(.is-ready) {
    opacity: 1;
  }

  .hero__veil {
    position: absolute;
    inset: -1px 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, var(--ink) 0%, rgba(11, 11, 12, 0.7) 14%, rgba(11, 11, 12, 0) 42%),
      linear-gradient(0deg, var(--ink) 0%, rgba(11, 11, 12, 0.72) 16%, rgba(11, 11, 12, 0) 38%),
      linear-gradient(90deg, rgba(11, 11, 12, 0.55) 0%, rgba(11, 11, 12, 0) 40%),
      radial-gradient(120% 90% at 50% 55%, transparent 55%, rgba(11, 11, 12, 0.55) 100%);
  }

  .hero__curtain {
    position: absolute;
    inset: 0;
    background: var(--ink);
    pointer-events: none;
    animation: hero-curtain 1.6s var(--ease-soft) 0.1s both;
  }

  /* ── Content ───────────────────────────────────────── */
  .hero__inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(var(--header-h) + clamp(0.5rem, 4vh, 3rem));
    padding-bottom: clamp(1.25rem, 5vh, 3rem);
  }

  .hero__eyebrow {
    margin-bottom: clamp(1rem, 2.5vh, 1.75rem);
    animation: hero-fade 1.2s var(--ease-out) 0.7s both;
  }

  .hero__title {
    font-size: clamp(3.5rem, 7.4vw, 9.5rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    max-width: 12ch;
  }

  .hl {
    display: inline-block;
    overflow: clip;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
    vertical-align: top;
  }

  .hl__in {
    display: inline-block;
    animation: hero-rise 1.5s var(--ease-out) both;
  }

  .hl:nth-child(1) .hl__in { animation-delay: 0.35s; }
  .hl:nth-child(2) .hl__in { animation-delay: 0.47s; }
  .hl:nth-child(3) .hl__in { animation-delay: 0.59s; }

  .hero__title em {
    color: var(--copper);
    padding-right: 0.06em;
  }

  .hero__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
  }

  .hero__cta-group,
  .hero__chapters {
    grid-area: 1 / 1;
  }

  .hero__cta-group {
    animation: hero-fade 1.2s var(--ease-out) 0.95s both;
  }

  .hero__lead {
    max-width: 34ch;
    margin-bottom: 1.75rem;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--bone-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Chapters: only shown while the scroll-driven sequence is active */
  .hero__chapters {
    display: none;
    position: relative;
    align-self: end;
  }

  :global(html.js) .hero__chapters {
    display: grid;
  }

  .chapter {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-end;
    gap: clamp(1rem, 2vw, 2rem);
    visibility: hidden;
  }

  .chapter__num {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 8.5rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--bone);
  }

  .chapter__text {
    max-width: 22ch;
    padding-bottom: 0.4rem;
    border-top: 1px solid var(--copper);
    padding-top: 0.875rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--bone-2);
  }

  /* HUD */
  .hud {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    animation: hero-fade 1.4s var(--ease-out) 1.2s both;
  }

  :global(html.js) .hud {
    display: flex;
  }

  .hud__readout {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .hud__label,
  .hud__coords {
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hud__value {
    font-size: clamp(1.75rem, 2.4vw, 2.5rem);
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hud__dial {
    position: relative;
    width: clamp(11rem, 16vw, 16rem);
    height: 1.25rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
  }

  .hud__scale {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 300%;
    background:
      repeating-linear-gradient(90deg, var(--bone-2) 0 1px, transparent 1px 40px) 0 0 / 100% 100%,
      repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px 8px) 0 50% / 100% 50% no-repeat;
    will-change: transform;
  }

  .hud__needle {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--copper);
  }

  /* Scroll cue */
  .hero__cue {
    display: none;
    position: absolute;
    left: 50%;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    z-index: 2;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transform: translateX(-50%);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bone-2);
    animation: hero-fade 1.2s var(--ease-out) 1.4s both;
  }

  :global(html.js) .hero__cue {
    display: flex;
  }

  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 3rem;
    overflow: hidden;
    background: var(--line);
  }

  .hero__cue-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--copper);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__chapters,
    :global(html.js) .hud,
    :global(html.js) .hero__cue {
      display: none;
    }
  }

  /* ── Landscape, roomy screens ───────────────────────── */
  @media (min-width: 1024px) {
    .hero__title {
      max-width: none;
    }

    .hl:nth-child(2) {
      margin-right: 0;
    }

    .hl:nth-child(3) {
      display: block;
      width: fit-content;
    }
  }

  @media (max-height: 640px) and (orientation: landscape) {
    .hero__lead {
      display: none;
    }

    .hero__title {
      font-size: clamp(2.5rem, 6.5vw, 5rem);
      max-width: none;
    }

    .hl:nth-child(3) {
      display: block;
      width: fit-content;
    }

    .hero__eyebrow {
      margin-bottom: 0.75rem;
    }

    .hero__cue,
    :global(html.js) .hero__cue {
      display: none;
    }

    .chapter__num {
      font-size: clamp(3rem, 7vw, 5rem);
    }
  }

  /* ── Portrait phones & tablets: cinematic letterbox ─── */
  @media (orientation: portrait) and (max-width: 1023px) {
    .hero__sticky {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas: "intro" "media" "foot";
      padding-top: calc(var(--header-h) + clamp(0.5rem, 3vh, 2rem));
      padding-bottom: clamp(1.25rem, 4vh, 2.5rem);
    }

    .hero__inner {
      display: contents;
    }

    .hero__intro,
    .hero__foot {
      position: relative;
      z-index: 2;
      padding-inline: var(--gutter);
    }

    .hero__intro {
      grid-area: intro;
    }

    .hero__foot {
      grid-area: foot;
    }

    .hero__media {
      grid-area: media;
      position: relative;
      inset: auto;
      align-self: center;
      width: 100%;
      aspect-ratio: 3 / 2;
      max-height: 100%;
      -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 82%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 82%, transparent 100%);
    }

    .hero__veil {
      background: radial-gradient(120% 100% at 50% 50%, transparent 60%, rgba(11, 11, 12, 0.6) 100%);
    }

    .hero__title {
      font-size: min(15vw, 6.5rem);
    }

    .hl {
      display: block;
      width: fit-content;
    }

    .hero__foot {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__lead {
      display: none;
    }

    .hud,
    :global(html.js) .hud {
      display: none;
    }

    .hero__cue,
    :global(html.js) .hero__cue {
      display: none;
    }

    .chapter__num {
      font-size: min(16vw, 6rem);
    }
  }

  @media (orientation: portrait) and (min-width: 600px) and (max-width: 1023px) {
    .hero__lead {
      display: block;
    }
  }

  @media (max-width: 479px) {
    .hero__secondary {
      display: none;
    }
  }

  /* ── Keyframes ──────────────────────────────────────── */
  @keyframes hero-zoom {
    from {
      transform: scale(1.18);
    }
  }

  @keyframes hero-curtain {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }
</style>

<script>
  import { gsap, reducedMotion } from "../scripts/motion";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero && !reducedMotion()) initHero(hero);

  function initHero(hero: HTMLElement) {
    const canvas = hero.querySelector<HTMLCanvasElement>("[data-hero-canvas]")!;
    const poster = hero.querySelector<HTMLImageElement>("[data-hero-poster]")!;
    const ctx = canvas.getContext("2d", { alpha: false });
    if (!ctx) return;

    const count = Number(hero.dataset.frames);
    const base = hero.dataset.base!;
    const frames: (HTMLImageElement | null)[] = Array(count).fill(null);
    const pad = (n: number) => String(n).padStart(2, "0");
    const dpr = () => Math.min(window.devicePixelRatio || 1, 2);

    // ── Frame source size: smallest set that covers the box at device resolution
    const coverWidth = () => {
      const r = canvas.getBoundingClientRect();
      return Math.max(r.width, (r.height * 16) / 9);
    };
    const need = coverWidth() * dpr();
    const size = need <= 700 ? 640 : need <= 1100 ? 960 : 1280;

    // ── Canvas sizing (never more pixels than the source frames provide)
    function resize() {
      const r = canvas.getBoundingClientRect();
      const ratio = Math.min(dpr(), Math.max(1, size / coverWidth()));
      canvas.width = Math.max(1, Math.round(r.width * ratio));
      canvas.height = Math.max(1, Math.round(r.height * ratio));
      drawn = -1;
      requestRender();
    }

    // ── Rendering: eased playhead + cross-fade between neighbouring frames
    let target = 0;
    let current = 0;
    let drawn = -1;
    let raf = 0;

    function drawImage(img: HTMLImageElement, alpha: number) {
      const cw = canvas.width;
      const ch = canvas.height;
      const s = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * s;
      const h = img.naturalHeight * s;
      ctx!.globalAlpha = alpha;
      ctx!.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    }

    function nearest(i: number) {
      for (let d = 0; d < count; d++) {
        if (frames[i - d]) return frames[i - d];
        if (frames[i + d]) return frames[i + d];
      }
      return null;
    }

    function paint(pos: number) {
      const i = Math.floor(pos);
      const f = pos - i;
      const a = frames[i] ?? nearest(i);
      if (!a) return false;
      drawImage(a, 1);
      const b = frames[i + 1];
      if (f > 0.01 && frames[i] && b) drawImage(b, f);
      ctx!.globalAlpha = 1;
      return true;
    }

    function tick() {
      raf = 0;
      current += (target - current) * 0.16;
      if (Math.abs(target - current) < 0.001) current = target;
      if (current !== drawn && paint(current)) {
        drawn = current;
        canvas.classList.add("is-ready");
      }
      if (current !== target) raf = requestAnimationFrame(tick);
    }

    function requestRender() {
      if (!raf) raf = requestAnimationFrame(tick);
    }

    // ── Progressive loading: coarse frames first so scrubbing works early
    const order: number[] = [];
    const seen = new Set<number>();
    for (let step = 16; step >= 1; step = Math.floor(step / 2)) {
      for (let i = 0; i < count; i += step) if (!seen.has(i)) (seen.add(i), order.push(i));
    }
    if (!seen.has(count - 1)) order.push(count - 1);

    let started = false;
    function load() {
      if (started) return;
      started = true;
      let next = 0;
      const worker = async () => {
        while (next < order.length) {
          const i = order[next++];
          const img = new Image();
          img.decoding = "async";
          img.src = `${base}/${size}/${pad(i + 1)}.webp`;
          try {
            await img.decode();
            frames[i] = img;
            if (drawn === -1 || Math.abs(i - current) < 2) {
              drawn = -1;
              requestRender();
            }
          } catch {
            /* a missing frame falls back to its nearest neighbour */
          }
        }
      };
      for (let k = 0; k < 4; k++) worker();
    }

    const idle = (cb: () => void) =>
      "requestIdleCallback" in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 300);
    if (document.readyState === "complete") idle(load);
    else window.addEventListener("load", () => idle(load), { once: true });
    window.addEventListener("scroll", load, { once: true, passive: true });

    if (poster.complete && poster.currentSrc.includes(`/${size}/01.webp`)) frames[0] = poster;

    resize();
    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 100);
    }).observe(canvas);

    // ── HUD
    const angleEl = hero.querySelector<HTMLElement>("[data-hud-angle]");
    const scaleEl = hero.querySelector<HTMLElement>("[data-hud-scale]");
    let lastAngle = -1;
    function updateHud(p: number) {
      const angle = Math.round(p * 180);
      if (angle !== lastAngle && angleEl) {
        angleEl.textContent = String(angle).padStart(3, "0");
        lastAngle = angle;
      }
      if (scaleEl) scaleEl.style.transform = `translate3d(${-p * 66.666}%,0,0)`;
    }

    // ── Scroll choreography
    const SEQ_END = 0.9;
    const intro = hero.querySelector("[data-hero-intro]");
    const foot = hero.querySelector("[data-hero-foot]");
    const cue = hero.querySelector("[data-hero-cue]");
    const media = hero.querySelector("[data-hero-media]");
    const scaleWrap = hero.querySelector("[data-hero-scale]");
    const chapters = gsap.utils.toArray<HTMLElement>(".chapter", hero);

    const mm = gsap.matchMedia();
    mm.add(
      {
        portrait: "(orientation: portrait) and (max-width: 1023px)",
        landscape: "not ((orientation: portrait) and (max-width: 1023px))",
      },
      (context) => {
        const { portrait } = context.conditions as { portrait: boolean };

        const tl = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "bottom bottom",
            scrub: true,
            onUpdate(self) {
              const p = Math.min(1, self.progress / SEQ_END);
              target = p * (count - 1);
              requestRender();
              updateHud(p);
            },
          },
        });

        tl.to(cue, { autoAlpha: 0, duration: 0.04 }, 0)
          .to(intro, { y: portrait ? -60 : -120, autoAlpha: 0, duration: 0.14, ease: "power1.in" }, 0.01)
          .to(foot, { y: 40, autoAlpha: 0, duration: 0.1, ease: "power1.in" }, 0.01)
          .fromTo(scaleWrap, { scale: 1 }, { scale: portrait ? 1.06 : 1.1, duration: 1 }, 0);

        if (portrait) tl.to(media, { yPercent: -45, duration: 0.18, ease: "power1.inOut" }, 0.02);

        const slots = [
          [0.16, 0.38],
          [0.43, 0.65],
          [0.7, 1.1],
        ];
        chapters.forEach((ch, i) => {
          const [inAt, outAt] = slots[i];
          tl.fromTo(
            ch,
            { autoAlpha: 0, y: 70 },
            { autoAlpha: 1, y: 0, duration: 0.07, ease: "power2.out" },
            inAt,
          );
          if (outAt < 1) tl.to(ch, { autoAlpha: 0, y: -50, duration: 0.06, ease: "power2.in" }, outAt);
        });
        tl.to({}, { duration: 0.001 }, 1);
      },
    );
  }
</script>
