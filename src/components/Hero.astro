---
//@ts-nocheck
import { Image } from "astro:assets";
import { useTranslations } from "../i18n/utils";
import heroImg from "../assets/hero/hero_bg.webp";

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <!-- Background image with Ken Burns -->
  <div class="hero-bg">
    <Image
      src={heroImg}
      alt=""
      class="hero-bg__img"
      format="webp"
      quality={80}
      width={1920}
      height={1080}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-bg__overlay"></div>
  </div>

  <!-- Decorative diagonal slash -->
  <div class="hero-slash" aria-hidden="true"></div>

  <!-- Content -->
  <div class="hero-content container">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow__line"></span>
      <span class="hero-eyebrow__text">{t("hero.surtitle")}</span>
    </div>

    <h1 class="hero-title">
      <span class="hero-title__top">{t("hero.title")}</span>
    </h1>

    <a href="#contact" class="hero-cta">
      <span class="hero-cta__text">{t("hero.cta")}</span>
      <span class="hero-cta__icon" aria-hidden="true">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
      <span class="hero-cta__ripple"></span>
    </a>

    <!-- Scroll indicator -->
    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll__line"></span>
      <span class="hero-scroll__label">SCROLL</span>
    </div>
  </div>
</section>

<style>
  /* ── Background ─────────────────────────────────────── */
  .hero {
    height: 100vh;
    min-height: 600px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center center;
    animation: kenBurns 18s ease-in-out infinite alternate;
  }

  @keyframes kenBurns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.2);
    }
  }

  /* Multi-layer overlay: dark vignette + directional gradient */
  .hero-bg__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgba(26, 26, 26, 0.92) 0%,
        rgba(26, 26, 26, 0.7) 55%,
        rgba(26, 26, 26, 0.3) 100%
      ),
      radial-gradient(
        ellipse at 80% 50%,
        transparent 40%,
        rgba(26, 26, 26, 0.55) 100%
      );
  }

  /* ── Diagonal accent slash ───────────────────────────── */
  .hero-slash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent calc(60% - 1px),
      rgba(211, 84, 0, 0.25) calc(60% - 1px),
      rgba(211, 84, 0, 0.25) 60%,
      transparent 60%
    );
  }

  /* ── Content layout ──────────────────────────────────── */
  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 6rem;
    max-width: 800px;
  }

  /* ── Eyebrow ─────────────────────────────────────────── */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .hero-eyebrow__line {
    display: block;
    width: 36px;
    height: 2px;
    background: var(--color-accent);
  }

  .hero-eyebrow__text {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    color: var(--color-accent);
  }

  /* ── Title ───────────────────────────────────────────── */
  .hero-title {
    margin: 0;
    animation: fadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }

  .hero-title__top {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.5);
  }

  .hero-title__top::after {
    content: "";
    display: block;
    width: 80px;
    height: 4px;
    background: var(--color-accent);
    border-radius: 2px;
    margin-top: 1rem;
  }

  /* ── CTA Button ──────────────────────────────────────── */
  .hero-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    width: fit-content;
    border: 2px solid var(--color-accent);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    overflow: hidden;
    cursor: pointer;
    transition: color 0.35s ease;
    animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }

  .hero-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: translateX(-105%);
    transition: transform 0.4s cubic-bezier(0.77, 0, 0.175, 1);
    z-index: 0;
  }

  .hero-cta:hover::before {
    transform: translateX(0);
  }

  .hero-cta__text,
  .hero-cta__icon {
    position: relative;
    z-index: 1;
  }

  .hero-cta__icon {
    display: flex;
    align-items: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-cta:hover .hero-cta__icon {
    transform: translateX(5px);
  }

  .hero-cta__ripple {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* ── Scroll indicator ────────────────────────────────── */
  .hero-scroll {
    padding-top: 1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    animation: fadeUp 1s ease 1s both;
  }

  .hero-scroll__line {
    display: block;
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 1;
      transform: scaleY(1);
    }
    50% {
      opacity: 0.4;
      transform: scaleY(0.6);
    }
  }

  .hero-scroll__label {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--color-gray);
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  /* ── Shared animation ────────────────────────────────── */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 600px) {
    .hero-slash {
      display: none;
    }

    .hero-content {
      gap: 1.5rem;
      padding-top: 5rem;
    }

    .hero-cta {
      padding: 0.875rem 1.5rem;
    }
  }
</style>
