---
//@ts-nocheck
import { useTranslations } from "../i18n/utils";

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    id: "01",
    name: t("services.mechanic"),
    desc: t("services.mechanic.desc"),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M38 10l-4 4-4-4 4-4 4 4z"/>
      <path d="M34 14L20 28"/>
      <circle cx="14" cy="34" r="6"/>
      <path d="M14 28v-4M14 40v4M8 34H4M24 34h4"/>
    </svg>`,
  },
  {
    id: "02",
    name: t("services.itv"),
    desc: t("services.itv.desc"),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="10" width="36" height="28" rx="3"/>
      <path d="M16 26l5 5 11-12"/>
      <path d="M6 18h36"/>
    </svg>`,
  },
  {
    id: "03",
    name: t("services.brakes"),
    desc: t("services.brakes.desc"),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="16"/>
      <circle cx="24" cy="24" r="6"/>
      <path d="M24 8v5M24 35v5M8 24h5M35 24h5"/>
      <path d="M13.4 13.4l3.5 3.5M31.1 31.1l3.5 3.5"/>
    </svg>`,
  },
  {
    id: "04",
    name: t("services.diagnosis"),
    desc: t("services.diagnosis.desc"),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="12" width="32" height="22" rx="2"/>
      <path d="M16 38h16M24 34v4"/>
      <path d="M14 24h4l3 5 4-9 3 5 4-1h4"/>
    </svg>`,
  },
  {
    id: "05",
    name: t("services.oil"),
    desc: t("services.oil.desc"),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 8h12v6l4 4v18a4 4 0 01-4 4H18a4 4 0 01-4-4V18l4-4V8z"/>
      <path d="M14 22h20"/>
      <path d="M24 8V4M30 6l6-3"/>
      <circle cx="24" cy="32" r="3"/>
    </svg>`,
  },
  {
    id: "06",
    name: t("services.tires"),
    desc: t("services.tires.desc"),
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="24" cy="24" r="17"/>
      <circle cx="24" cy="24" r="8"/>
      <path d="M24 7v4M24 37v4M7 24h4M37 24h4"/>
      <path d="M13 13l3 3M32 32l3 3M13 35l3-3M32 16l3-3"/>
    </svg>`,
  },
];
---

<section id="services" class="services-section">

  <!-- Grid background texture -->
  <div class="services-bg" aria-hidden="true">
    <div class="services-bg__grid"></div>
  </div>

  <div class="container">

    <!-- Header -->
    <div class="services-header">
      <div class="services-label">
        <span class="services-label__line"></span>
        <span class="services-label__text">{t("services.surtitle")}</span>
      </div>
      <h2 class="services-title">{t("services.title")}</h2>
    </div>

    <!-- Grid -->
    <div class="services-grid">
      {services.map((service, i) => (
        <div class="flip-card" tabindex="0" aria-label={service.name}>
          <div class="flip-card__inner">

            <!-- Front -->
            <div class="flip-card__front" aria-hidden="true">
              <span class="flip-card__num">{service.id}</span>
              <div class="flip-card__icon" set:html={service.svg} />
              <h3 class="flip-card__name">{service.name}</h3>
              <div class="flip-card__hint">
                <span>Ver más</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>

            <!-- Back -->
            <div class="flip-card__back">
              <span class="flip-card__num">{service.id}</span>
              <h3 class="flip-card__name">{service.name}</h3>
              <p class="flip-card__desc">{service.desc}</p>
              <div class="flip-card__back-bar"></div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Section ─────────────────────────────────────────── */
  .services-section {
    padding: 8rem 0;
    background-color: var(--color-secondary);
    position: relative;
    overflow: hidden;
  }

  /* Grid texture */
  .services-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .services-bg__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at 50% 50%, black 30%, transparent 80%);
  }

  /* ── Header ──────────────────────────────────────────── */
  .services-header {
    position: relative;
    z-index: 1;
    margin-bottom: 4rem;
  }

  .services-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .services-label__line {
    display: block;
    width: 36px;
    height: 2px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .services-label__text {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: var(--color-accent);
  }

  .services-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
    margin: 0;
  }

  /* ── Grid ────────────────────────────────────────────── */
  .services-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* ── Flip card shell ─────────────────────────────────── */
  .flip-card {
    perspective: 1200px;
    height: 300px;
    cursor: pointer;
    outline: none;
    border-radius: 36px;
  }

  .flip-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.45, 0, 0.15, 1);
  }

  .flip-card:hover .flip-card__inner,
  .flip-card:focus-within .flip-card__inner {
    transform: rotateY(180deg);
  }

  /* ── Front & Back shared ─────────────────────────────── */
  .flip-card__front,
  .flip-card__back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: 1px solid rgba(255,255,255,0.06);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    border-radius: 36px;
  }

  /* ── Front ───────────────────────────────────────────── */
  .flip-card__front {
    background: var(--color-primary);
    justify-content: flex-end;
    transition: border-color 0.3s ease;
  }

  .flip-card:hover .flip-card__front {
    border-color: var(--color-accent);
  }

  /* Accent left border that grows in */
  .flip-card__front::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 2px;
    background: var(--color-accent);
    border-radius: 0 2px 2px 0;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.4s ease;
  }

  .flip-card:hover .flip-card__front::before {
    transform: scaleY(1);
  }

  .flip-card__num {
    position: absolute;
    top: 1.5rem;
    right: 1.75rem;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-accent);
  }

  .flip-card__icon {
    width: 52px;
    height: 52px;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    flex-shrink: 0;
    transition: color 0.3s ease;
  }

  .flip-card:hover .flip-card__icon {
    color: var(--color-accent);
  }

  .flip-card__name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .flip-card__hint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-top: auto;
  }

  /* ── Back ────────────────────────────────────────────── */
  .flip-card__back {
    background: var(--color-accent);
    transform: rotateY(180deg);
    justify-content: flex-end;
    border-color: var(--color-accent);
  }

  .flip-card__back .flip-card__num {
    color: rgba(255,255,255,0.45);
  }

  .flip-card__back .flip-card__name {
    color: #fff;
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .flip-card__desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }

  .flip-card__back-bar {
    margin-top: 1.5rem;
    height: 1px;
    background: rgba(255,255,255,0.3);
    width: 40px;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    /* On mobile: skip the flip, show both stacked */
    .flip-card {
      height: auto;
      cursor: default;
    }

    .flip-card__inner {
      transform: none !important;
      transform-style: flat;
    }

    .flip-card__front {
      display: none;
    }

    .flip-card__back {
      position: static;
      transform: none;
      backface-visibility: visible;
      -webkit-backface-visibility: visible;
    }

    .services-section {
      padding: 5rem 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // Set initial states explicitly — no reliance on CSS classes
    gsap.set(".services-header", { opacity: 0, y: 40 });
    gsap.set(".flip-card", { opacity: 0, y: 50 });

    gsap.to(".services-header", {
      scrollTrigger: {
        trigger: ".services-header",
        start: "top 85%",
        once: true,
      },
      opacity: 1,
      y: 0,
      duration: 0.9,
      ease: "power3.out",
    });

    gsap.to(".flip-card", {
      scrollTrigger: {
        trigger: ".services-grid",
        start: "top 80%",
        once: true,
      },
      opacity: 1,
      y: 0,
      duration: 0.7,
      stagger: 0.1,
      ease: "power2.out",
    });
  });
</script>