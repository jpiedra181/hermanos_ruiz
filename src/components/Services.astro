---
import { Image } from "astro:assets";
import { useTranslations, type Lang } from "../i18n/utils";
import mechanic from "../assets/services/mechanic.jpg";
import itv from "../assets/services/itv.jpg";
import brakes from "../assets/services/brakes.jpg";
import diagnosis from "../assets/services/diagnosis.jpg";
import oil from "../assets/services/oil.jpg";
import tires from "../assets/services/tires.jpg";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const icon = (body: string) =>
  `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;

const services = [
  {
    key: "mechanic",
    img: mechanic,
    svg: icon(`<path d="M38 10l-4 4-4-4 4-4 4 4z"/><path d="M34 14L20 28"/><circle cx="14" cy="34" r="6"/><path d="M14 28v-4M14 40v4M8 34H4M24 34h4"/>`),
  },
  {
    key: "itv",
    img: itv,
    svg: icon(`<rect x="6" y="10" width="36" height="28" rx="3"/><path d="M16 26l5 5 11-12"/><path d="M6 18h36"/>`),
  },
  {
    key: "brakes",
    img: brakes,
    svg: icon(`<circle cx="24" cy="24" r="16"/><circle cx="24" cy="24" r="6"/><path d="M24 8v5M24 35v5M8 24h5M35 24h5"/><path d="M13.4 13.4l3.5 3.5M31.1 31.1l3.5 3.5"/>`),
  },
  {
    key: "diagnosis",
    img: diagnosis,
    svg: icon(`<rect x="8" y="12" width="32" height="22" rx="2"/><path d="M16 38h16M24 34v4"/><path d="M14 24h4l3 5 4-9 3 5 4-1h4"/>`),
  },
  {
    key: "oil",
    img: oil,
    svg: icon(`<path d="M18 8h12v6l4 4v18a4 4 0 01-4 4H18a4 4 0 01-4-4V18l4-4V8z"/><path d="M14 22h20"/><path d="M24 8V4"/><circle cx="24" cy="32" r="3"/>`),
  },
  {
    key: "tires",
    img: tires,
    svg: icon(`<circle cx="24" cy="24" r="17"/><circle cx="24" cy="24" r="8"/><path d="M24 7v4M24 37v4M7 24h4M37 24h4"/><path d="M13 13l3 3M32 32l3 3M13 35l3-3M32 16l3-3"/>`),
  },
] as const;

const items = services.map((s) => ({
  ...s,
  name: t(`services.${s.key}` as "services.mechanic"),
  desc: t(`services.${s.key}.desc` as "services.mechanic.desc"),
}));
const arrow = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M7 17L17 7M9 7h8v8"/></svg>`;
---

<section id="services" class="services" aria-labelledby="services-title" data-services>
  <div class="container">
    <header class="services__head">
      <p class="eyebrow" data-reveal="fade">{t("services.surtitle")}</p>
      <h2 class="section-title" id="services-title" data-reveal="lines">
        {t("services.title.1")} <em>{t("services.title.2")}</em>
      </h2>
      <p class="services__intro" data-reveal="fade" data-delay="0.15">{t("services.intro")}</p>
    </header>

    <ol class="svc-list" data-svc-list>
      {
        items.map((s, i) => (
          <li class="svc" data-svc={i}>
            <span class="svc__num" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="svc__icon" aria-hidden="true" set:html={s.svg} />
            <h3 class="svc__name">{s.name}</h3>
            <p class="svc__desc">{s.desc}</p>
            <a
              class="svc__link"
              href="#contact"
              data-service={s.key}
              aria-label={`${t("services.cta")}: ${s.name}`}
            >
              <span class="svc__arrow" aria-hidden="true" set:html={arrow} />
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="svc-preview" aria-hidden="true" data-svc-preview>
    <div class="svc-preview__inner">
      {
        items.map((s, i) => (
          <div class="svc-preview__item" data-preview={i}>
            <Image src={s.img} alt="" widths={[400, 720]} sizes="22rem" loading="lazy" decoding="async" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding-block: var(--section);
    background: var(--ink);
    overflow: clip;
  }

  .services__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .services__intro {
    max-width: 40ch;
    font-size: var(--fs-lead);
    color: var(--bone-2);
  }

  @media (min-width: 1024px) {
    .services__head {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
      column-gap: 4rem;
    }

    .services__head .eyebrow {
      grid-column: 1 / -1;
    }

    .services__intro {
      justify-self: end;
      padding-bottom: 0.75rem;
    }
  }

  /* ── List ──────────────────────────────────────────── */
  .svc-list {
    border-top: 1px solid var(--line);
  }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "num icon link"
      "name name name"
      "desc desc desc";
    align-items: center;
    column-gap: 1rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }

  .svc::before {
    content: "";
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    z-index: -1;
    background: var(--ink-3);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.7s var(--ease-out);
  }

  .svc__num {
    grid-area: num;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--copper);
  }

  .svc__icon {
    grid-area: icon;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--bone-2);
    transition: color 0.5s, transform 0.8s var(--ease-out);
  }

  .svc__name {
    grid-area: name;
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 4.6vw, 4.5rem);
    line-height: 1;
    transition: transform 0.8s var(--ease-out), color 0.5s;
  }

  .svc__desc {
    grid-area: desc;
    margin-top: 0.875rem;
    max-width: 38ch;
    color: var(--bone-2);
  }

  .svc__link {
    grid-area: link;
    justify-self: end;
    border-radius: 50%;
  }

  .svc__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .svc__link:focus-visible {
    outline: none;
  }

  .svc:has(.svc__link:focus-visible) {
    outline: 2px solid var(--copper);
    outline-offset: 4px;
  }

  .svc__arrow {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color 0.5s, border-color 0.5s, color 0.5s;
  }

  .svc__arrow :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.6s var(--ease-out);
  }

  @media (min-width: 768px) {
    .svc {
      grid-template-columns: 4rem 3rem minmax(0, 1.3fr) minmax(0, 1fr) auto;
      grid-template-areas: "num icon name desc link";
      column-gap: clamp(1rem, 2.5vw, 2.5rem);
      padding-block: clamp(1.75rem, 3vw, 2.75rem);
    }

    .svc__name,
    .svc__desc {
      margin-top: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .svc:hover::before {
      transform: scaleY(1);
    }

    .svc:hover .svc__name {
      transform: translateX(1rem);
      color: var(--copper);
    }

    .svc:hover .svc__icon {
      color: var(--copper);
      transform: rotate(-12deg) scale(1.08);
    }

    .svc:hover .svc__arrow {
      background: var(--copper);
      border-color: var(--copper);
      color: var(--ink);
    }

    .svc:hover .svc__arrow :global(svg) {
      transform: rotate(45deg);
    }
  }

  /* ── Cursor preview ────────────────────────────────── */
  .svc-preview {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .svc-preview {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 5;
      width: 22rem;
      aspect-ratio: 16 / 10;
      margin: -6.875rem 0 0 -11rem;
      pointer-events: none;
      will-change: transform;
    }

    .svc-preview__inner {
      position: absolute;
      inset: 0;
      overflow: hidden;
      border-radius: var(--radius);
      opacity: 0;
      transform: scale(0.6);
      transition:
        opacity 0.4s var(--ease-out),
        transform 0.6s var(--ease-out);
    }

    .svc-preview.is-visible .svc-preview__inner {
      opacity: 1;
      transform: none;
    }
  }

  .svc-preview__item {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.7s var(--ease-in-out);
  }

  .svc-preview__item.is-active {
    clip-path: inset(0 0 0 0);
    z-index: 1;
  }

  .svc-preview__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
    transition: transform 1.2s var(--ease-out);
  }

  .svc-preview__item.is-active :global(img) {
    transform: scale(1);
  }
</style>

<script>
  import { gsap, reducedMotion, finePointer } from "../scripts/motion";

  const root = document.querySelector<HTMLElement>("[data-services]");
  if (root) {
    const rows = gsap.utils.toArray<HTMLElement>("[data-svc]", root);

    // Pick the service in the booking form when a row is chosen.
    root.querySelectorAll<HTMLAnchorElement>("[data-service]").forEach((link) => {
      link.addEventListener("click", () => {
        const select = document.querySelector<HTMLSelectElement>("#f-service");
        if (!select) return;
        select.value = link.dataset.service!;
        select.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });

    if (!reducedMotion()) {
      gsap.from(rows, {
        y: 40,
        autoAlpha: 0,
        duration: 1.2,
        ease: "expo.out",
        stagger: 0.07,
        scrollTrigger: { trigger: root.querySelector("[data-svc-list]"), start: "top 85%", once: true },
      });
    }

    const preview = root.querySelector<HTMLElement>("[data-svc-preview]");
    if (preview && finePointer()) {
      const items = gsap.utils.toArray<HTMLElement>("[data-preview]", preview);
      const xTo = gsap.quickTo(preview, "x", { duration: 0.7, ease: "power3.out" });
      const yTo = gsap.quickTo(preview, "y", { duration: 0.7, ease: "power3.out" });
      const rTo = gsap.quickTo(preview, "rotation", { duration: 0.9, ease: "power3.out" });
      let lastX = 0;

      const move = (e: PointerEvent) => {
        const r = root.getBoundingClientRect();
        const x = e.clientX - r.left;
        xTo(x);
        yTo(e.clientY - r.top);
        if (!reducedMotion()) rTo(gsap.utils.clamp(-8, 8, (x - lastX) * 0.4));
        lastX = x;
      };

      rows.forEach((row, i) => {
        row.addEventListener("pointerenter", (e) => {
          items.forEach((it, k) => it.classList.toggle("is-active", k === i));
          preview.classList.add("is-visible");
          const r = root.getBoundingClientRect();
          if (!preview.dataset.placed) {
            gsap.set(preview, { x: e.clientX - r.left, y: e.clientY - r.top });
            preview.dataset.placed = "1";
          }
        });
      });
      root.querySelector("[data-svc-list]")?.addEventListener("pointerleave", () => {
        preview.classList.remove("is-visible");
        rTo(0);
      });
      root.addEventListener("pointermove", move);
    }
  }
</script>
