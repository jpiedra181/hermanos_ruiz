---
import { useTranslations } from "../i18n/utils";

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const homeLink = `/${lang}/#hero`;
const servicesLink = `/${lang}/#services`;
const aboutLink = `/${lang}/#about`;
const contactLink = `/${lang}/#contact`;
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="brand">
        <h3>Taller Hermanos Ruiz</h3>
        <p>{t("footer.slogan")}</p>
      </div>
      <div class="links">
        <a href={homeLink}>{t("nav.home")}</a>
        <a href={servicesLink}>{t("nav.services")}</a>
        <a href={aboutLink}>{t("nav.about")}</a>
        <a href={contactLink}>{t("nav.contact")}</a>
      </div>
    </div>
    <div class="legal">
      <p>&copy; {currentYear} Taller Hermanos Ruiz. {t("footer.rights")}</p>
      <a href="#">{t("footer.privacy")}</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: black;
    padding: 4rem 0 2rem;
    border-top: 1px solid #333;
    font-size: 0.9rem;
    color: #888;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  h3 {
    color: white;
    margin-bottom: 0.5rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .links a {
    color: #ccc;
    transition: color 0.3s;
  }

  .links a:hover {
    color: var(--color-accent);
  }

  .legal {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid #222;
    padding-top: 2rem;
  }

  @media (min-width: 768px) {
    .legal {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
