---
import { useTranslations, type Lang } from "../i18n/utils";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const reviews = [1, 2, 3, 4, 5, 6].map((n) => {
  const name = t(`reviews.${n}.author` as "reviews.1.author");
  return {
    name,
    text: t(`reviews.${n}.text` as "reviews.1.text"),
    initials: name
      .split(/\s+/)
      .map((w) => w[0])
      .join("")
      .slice(0, 2)
      .toUpperCase(),
  };
});
const pad = (n: number) => String(n).padStart(2, "0");
const chevron = (d: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
---

<section class="reviews" aria-labelledby="reviews-title" data-reviews>
  <div class="container reviews__grid">
    <div class="reviews__head">
      <p class="eyebrow" data-reveal="fade">{t("reviews.eyebrow")}</p>
      <h2 class="section-title reviews__title" id="reviews-title" data-reveal="lines">
        {t("reviews.title")}
      </h2>
    </div>

    <div
      class="carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label={t("reviews.label")}
      data-carousel
    >
      <div class="carousel__controls">
        <button
          class="carousel__btn"
          type="button"
          data-toggle
          data-label-pause={t("reviews.pause")}
          data-label-play={t("reviews.play")}
          aria-label={t("reviews.pause")}
        >
          <span class="icon-pause" aria-hidden="true" set:html={chevron("M9 6v12M15 6v12")} />
          <span class="icon-play" aria-hidden="true" set:html={chevron("M8 5.5v13l10-6.5z")} />
        </button>
        <button class="carousel__btn" type="button" data-prev aria-label={t("reviews.prev")}>
          <span aria-hidden="true" set:html={chevron("M15 6l-6 6 6 6")} />
        </button>
        <button class="carousel__btn" type="button" data-next aria-label={t("reviews.next")}>
          <span aria-hidden="true" set:html={chevron("M9 6l6 6-6 6")} />
        </button>
        <p class="carousel__count" aria-hidden="true">
          <span data-count-current>01</span>
          <span class="carousel__count-sep"></span>
          <span>{pad(reviews.length)}</span>
        </p>
      </div>

      <div class="carousel__viewport" data-viewport aria-live="off">
        {
          reviews.map((r, i) => (
            <div
              class:list={["review", { "is-active": i === 0 }]}
              role="group"
              aria-roledescription={t("reviews.slide")}
              aria-label={`${i + 1} ${t("reviews.of")} ${reviews.length}`}
              data-slide={i}
            >
              <figure class="review__figure">
                <blockquote class="review__quote">
                  <p>{r.text}</p>
                </blockquote>
                <figcaption class="review__author">
                  <span class="review__avatar" aria-hidden="true">
                    {r.initials}
                  </span>
                  <span>{r.name}</span>
                </figcaption>
              </figure>
            </div>
          ))
        }
      </div>

      <div class="carousel__progress" aria-hidden="true">
        {reviews.map((_, i) => <span class:list={["carousel__bar", { "is-active": i === 0 }]} data-bar={i}><span /></span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .reviews {
    position: relative;
    padding-block: var(--section);
    background: var(--ink);
    overflow: clip;
  }

  .reviews::before {
    content: "\201C";
    position: absolute;
    top: clamp(2rem, 6vw, 5rem);
    right: var(--gutter);
    font-family: var(--font-display);
    font-size: clamp(14rem, 34vw, 32rem);
    line-height: 0.8;
    color: var(--copper);
    opacity: 0.08;
    pointer-events: none;
  }

  .reviews__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .reviews__title {
    margin-top: 1.5rem;
    max-width: 10ch;
  }

  @media (min-width: 1024px) {
    .reviews__grid {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
  }

  /* ── Carousel ──────────────────────────────────────── */
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    order: 2;
  }

  .carousel__btn {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    transition: background-color 0.4s, border-color 0.4s, color 0.4s;
  }

  .carousel__btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .carousel__btn:hover {
    background: var(--bone);
    border-color: var(--bone);
    color: var(--ink);
  }

  .icon-play,
  .carousel.is-paused .icon-pause {
    display: none;
  }

  .carousel.is-paused .icon-play {
    display: block;
  }

  .carousel__count {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .carousel__count [data-count-current] {
    color: var(--bone);
  }

  .carousel__count-sep {
    width: 2rem;
    height: 1px;
    background: var(--line-strong);
  }

  .carousel__viewport {
    display: grid;
    touch-action: pan-y;
  }

  .review {
    grid-area: 1 / 1;
    margin: 0;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.6s var(--ease-out),
      visibility 0s linear 0.6s;
  }

  .review.is-active {
    visibility: visible;
    opacity: 1;
    transition-delay: 0.2s, 0s;
  }

  .review__figure {
    margin: 0;
  }

  .review__quote {
    margin: 0 0 2.5rem;
  }

  .review__quote p {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    transform: translateY(1.5rem);
    transition: transform 1.1s var(--ease-out);
  }

  .review__quote p::before {
    content: "\201C";
    color: var(--copper);
  }

  .review__quote p::after {
    content: "\201D";
    color: var(--copper);
  }

  .review.is-active .review__quote p {
    transform: none;
  }

  .review__author {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .review__avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--copper);
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--copper);
  }

  .carousel__progress {
    display: flex;
    gap: 0.5rem;
    order: 3;
  }

  .carousel__bar {
    position: relative;
    flex: 1;
    height: 2px;
    overflow: hidden;
    background: var(--line);
  }

  .carousel__bar span {
    position: absolute;
    inset: 0;
    background: var(--copper);
    transform-origin: left;
    transform: scaleX(0);
  }

  .carousel__bar.is-done span {
    transform: scaleX(1);
  }

  .carousel__bar.is-active span {
    animation: progress var(--duration, 7s) linear forwards;
  }

  .carousel.is-paused .carousel__bar.is-active span,
  .carousel.is-holding .carousel__bar.is-active span {
    animation-play-state: paused;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }
</style>

<script>
  import { reducedMotion } from "../scripts/motion";

  const root = document.querySelector<HTMLElement>("[data-carousel]");
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const bars = [...root.querySelectorAll<HTMLElement>("[data-bar]")];
    const viewport = root.querySelector<HTMLElement>("[data-viewport]")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const counter = root.querySelector<HTMLElement>("[data-count-current]")!;
    const DURATION = 7000;

    let index = 0;
    let paused = reducedMotion(); // never auto-advance for reduced-motion users
    let holding = false; // pointer over / focus inside
    let visible = false;
    let timer = 0;
    let startedAt = 0;
    let remaining = DURATION;

    root.style.setProperty("--duration", `${DURATION}ms`);

    function render() {
      slides.forEach((s, i) => s.classList.toggle("is-active", i === index));
      bars.forEach((b, i) => {
        b.classList.toggle("is-active", i === index);
        b.classList.toggle("is-done", i < index);
        if (i === index) {
          // restart the CSS progress animation
          const fill = b.firstElementChild as HTMLElement;
          fill.style.animation = "none";
          void fill.offsetWidth;
          fill.style.animation = "";
        }
      });
      counter.textContent = String(index + 1).padStart(2, "0");
    }

    const running = () => !paused && !holding && visible;

    function startClock() {
      if (timer || !running()) return;
      startedAt = performance.now();
      timer = window.setTimeout(() => {
        timer = 0;
        go(index + 1);
      }, remaining);
    }

    function stopClock() {
      if (!timer) return;
      clearTimeout(timer);
      timer = 0;
      remaining = Math.max(0, remaining - (performance.now() - startedAt));
    }

    function sync() {
      root.classList.toggle("is-holding", holding || !visible);
      running() ? startClock() : stopClock();
    }

    function go(next: number) {
      stopClock();
      index = (next + slides.length) % slides.length;
      remaining = DURATION;
      render();
      sync();
    }

    function setPaused(next: boolean) {
      paused = next;
      root.classList.toggle("is-paused", paused);
      toggle.setAttribute("aria-label", paused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!);
      viewport.setAttribute("aria-live", paused ? "polite" : "off");
      if (!paused) {
        stopClock();
        remaining = DURATION;
        render();
      }
      sync();
    }

    const hold = (next: boolean) => {
      holding = next;
      sync();
    };

    root.querySelector("[data-prev]")!.addEventListener("click", () => go(index - 1));
    root.querySelector("[data-next]")!.addEventListener("click", () => go(index + 1));
    toggle.addEventListener("click", () => setPaused(!paused));

    root.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && hold(true));
    root.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hold(false));
    root.addEventListener("focusin", () => hold(true));
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node)) hold(false);
    });

    // Swipe
    let x0: number | null = null;
    viewport.addEventListener("pointerdown", (e) => (x0 = e.clientX));
    viewport.addEventListener("pointerup", (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) go(index + (dx < 0 ? 1 : -1));
    });

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.35 },
    ).observe(root);

    setPaused(paused);
  }
</script>
