---
import { useTranslations, rich, plain, type Lang } from "../i18n/utils";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const text = t("manifesto.text");
---

<section class="manifesto" aria-labelledby="manifesto-title" data-manifesto>
  <div class="container manifesto__grid">
    <h2 class="eyebrow manifesto__eyebrow" id="manifesto-title" data-reveal="fade">
      {t("manifesto.eyebrow")}
    </h2>
    <p class="manifesto__text">
      <span class="visually-hidden">{plain(text)}</span>
      <span aria-hidden="true" data-manifesto-words set:html={rich(text)} />
    </p>
    <p class="manifesto__sign" data-reveal="fade">
      <span class="manifesto__sign-line" aria-hidden="true"></span>
      {t("manifesto.sign")}
    </p>
  </div>
</section>

<style>
  .manifesto {
    padding-block: clamp(4rem, 10vw, 9rem) var(--section);
    background: var(--ink);
  }

  .manifesto__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .manifesto__text {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.2vw, 6.25rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .manifesto__text :global(em) {
    color: var(--copper);
  }

  .manifesto__sign {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--fs-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .manifesto__sign-line {
    width: 3rem;
    height: 1px;
    background: var(--line-strong);
  }

  @media (min-width: 1024px) {
    .manifesto__grid {
      grid-template-columns: 1fr 3fr;
      align-items: start;
    }

    .manifesto__eyebrow {
      padding-top: 1.5rem;
    }

    .manifesto__sign {
      grid-column: 2;
    }
  }
</style>

<script>
  import { gsap, SplitText, reducedMotion } from "../scripts/motion";

  const words = document.querySelector<HTMLElement>("[data-manifesto-words]");
  if (words && !reducedMotion()) {
    const css = getComputedStyle(document.documentElement);
    const bone = css.getPropertyValue("--bone").trim();
    const copper = css.getPropertyValue("--copper").trim();

    // Words "light up" from a grey that still meets 3:1 for large text.
    SplitText.create(words, {
      type: "words",
      aria: "none",
      autoSplit: true,
      onSplit: (self) =>
        gsap.fromTo(
          self.words,
          { color: "#66625b" },
          {
            color: (_: number, el: Element) => (el.closest("em") ? copper : bone),
            ease: "none",
            stagger: 0.1,
            scrollTrigger: {
              trigger: words,
              start: "top 80%",
              end: "bottom 45%",
              scrub: true,
            },
          },
        ),
    });
  }
</script>
